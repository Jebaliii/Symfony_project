{% extends "base.html.twig" %}

{% block title %}Sélection d'Hôtel - Système de Réservation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <style>
        .hotel-page {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
        }
        
        .hotel-card-img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            border-radius: 12px 12px 0 0;
            transition: transform 0.3s ease;
        }
        
        .hotel-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            border-radius: 16px;
            overflow: hidden;
            background: white;
            height: 100%;
            position: relative;
        }
        
        .hotel-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
        }
        
        .hotel-card:hover .hotel-card-img {
            transform: scale(1.05);
        }
        
        .rating-stars {
            color: #fbbf24;
            font-size: 0.9rem;
        }
        
        .amenities-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        
        .amenity-badge {
            background: #f1f5f9;
            color: #475569;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        
        .price-tag {
            font-size: 1.5rem;
            font-weight: 700;
            color: #059669;
        }
        
        .price-per-night {
            font-size: 0.875rem;
            color: #64748b;
        }
        
        .availability-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            z-index: 2;
        }
        
        .hotel-details {
            position: relative;
            padding: 20px;
        }
        
        .hotel-name {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 8px;
        }
        
        .hotel-location {
            color: #64748b;
            font-size: 0.875rem;
            margin-bottom: 12px;
        }
        
        .swiper-hotel {
            height: 280px;
            border-radius: 12px 12px 0 0;
            overflow: hidden;
        }
        
        .swiper-pagination-bullet-active {
            background: white !important;
        }
        
        .swiper-button-next, .swiper-button-prev {
            color: white !important;
            background: rgba(0, 0, 0, 0.3);
            width: 40px !important;
            height: 40px !important;
            border-radius: 50%;
        }
        
        .swiper-button-next:after, .swiper-button-prev:after {
            font-size: 18px !important;
        }
        
        .no-image-placeholder {
            height: 280px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 4rem;
        }
        
        .filter-sidebar {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            height: fit-content;
            position: sticky;
            top: 20px;
        }
        
        .filter-header {
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        
        .filter-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1e293b;
        }
        
        .filter-group {
            margin-bottom: 25px;
        }
        
        .filter-label {
            font-weight: 600;
            color: #475569;
            margin-bottom: 10px;
            display: block;
        }
        
        .price-range-values {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            color: #64748b;
            font-size: 0.875rem;
        }
        
        .star-rating-filter .form-check {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }
        
        .star-rating-filter .form-check-label {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .amenities-filter .form-check {
            margin-bottom: 8px;
        }
        
        .reset-filters {
            width: 100%;
            margin-top: 20px;
        }
        
        .hotel-count-badge {
            background: #3b82f6;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 600;
        }
        
        .sort-dropdown .btn {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 16px;
            font-weight: 500;
        }
        
        .view-toggle .btn {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        
        .view-toggle .btn.active {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        
        .grid-view .hotel-card {
            margin-bottom: 30px;
        }
        
        .list-view .hotel-card {
            display: flex;
            flex-direction: row;
            height: auto;
            margin-bottom: 20px;
        }
        
        .list-view .hotel-card-img {
            width: 300px;
            height: 200px;
            border-radius: 12px 0 0 12px;
        }
        
        .list-view .swiper-hotel {
            width: 300px;
            height: 200px;
            border-radius: 12px 0 0 12px;
        }
        
        .list-view .no-image-placeholder {
            width: 300px;
            height: 200px;
        }
        
        .list-view .hotel-details {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .list-view .card-footer {
            margin-top: auto;
        }
        
        .booking-summary-card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            margin-bottom: 30px;
        }
        
        .summary-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 20px;
        }
        
        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f1f5f9;
        }
        
        .summary-label {
            color: #64748b;
        }
        
        .summary-value {
            font-weight: 500;
            color: #1e293b;
        }
        
        .summary-total {
            font-size: 1.25rem;
            font-weight: 700;
            color: #059669;
        }
        
        .loading-spinner {
            text-align: center;
            padding: 50px;
        }
        
        @media (max-width: 768px) {
            .list-view .hotel-card {
                flex-direction: column;
            }
            
            .list-view .hotel-card-img,
            .list-view .swiper-hotel,
            .list-view .no-image-placeholder {
                width: 100%;
                border-radius: 12px 12px 0 0;
            }
            
            .view-toggle {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="hotel-page">
    <!-- Barre de progression -->
    <div class="bg-white shadow-sm py-3">
        <div class="container">
            <div class="booking-progress">
                <div class="progress-steps">
                    <div class="step completed">
                        <div class="step-circle">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div class="step-label">Ville</div>
                    </div>
                    <div class="step-line completed"></div>
                    <div class="step completed">
                        <div class="step-circle">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div class="step-label">Dates</div>
                    </div>
                    <div class="step-line completed"></div>
                    <div class="step active">
                        <div class="step-circle">3</div>
                        <div class="step-label">Hôtel</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step">
                        <div class="step-circle">4</div>
                        <div class="step-label">Chambre</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step">
                        <div class="step-circle">5</div>
                        <div class="step-label">Confirmation</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid py-5">
        <div class="row">
            <!-- Sidebar de filtres -->
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="filter-sidebar">
                    <div class="filter-header">
                        <h4 class="filter-title"><i class="bi bi-funnel me-2"></i>Filtres</h4>
                        <div class="hotel-count-badge mt-2">
                            {{ hotels|length }} hôtel(s) trouvé(s)
                        </div>
                    </div>

                    <!-- Filtre par prix -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="bi bi-currency-euro me-1"></i>Prix par nuit
                        </label>
                        <input type="range" class="form-range" id="priceRange" min="0" max="1000" step="50">
                        <div class="price-range-values">
                            <span id="minPrice">0 TND</span>
                            <span id="maxPrice">1000 TND</span>
                        </div>
                    </div>

                    <!-- Filtre par étoiles -->
                    <div class="filter-group star-rating-filter">
                        <label class="filter-label">
                            <i class="bi bi-star me-1"></i>Classement
                        </label>
                        {% for i in range(5, 1) %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="star{{ i }}" data-rating="{{ i }}">
                            <label class="form-check-label" for="star{{ i }}">
                                {% for j in range(1, i) %}
                                <i class="bi bi-star-fill text-warning"></i>
                                {% endfor %}
                                <span class="ms-1">et plus</span>
                            </label>
                        </div>
                        {% endfor %}
                    </div>

                    <!-- Filtre par commodités -->
                    <div class="filter-group amenities-filter">
                        <label class="filter-label">
                            <i class="bi bi-check-circle me-1"></i>Commodités
                        </label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="wifiFilter">
                            <label class="form-check-label" for="wifiFilter">
                                <i class="bi bi-wifi text-primary"></i> WiFi gratuit
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="parkingFilter">
                            <label class="form-check-label" for="parkingFilter">
                                <i class="bi bi-p-square text-primary"></i> Parking
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="poolFilter">
                            <label class="form-check-label" for="poolFilter">
                                <i class="bi bi-droplet text-primary"></i> Piscine
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="breakfastFilter">
                            <label class="form-check-label" for="breakfastFilter">
                                <i class="bi bi-cup-hot text-primary"></i> Petit-déjeuner
                            </label>
                        </div>
                    </div>

                    <!-- Filtre par disponibilité -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="bi bi-check2-square me-1"></i>Disponibilité
                        </label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="availableOnly" checked>
                            <label class="form-check-label" for="availableOnly">
                                Afficher seulement les hôtels disponibles
                            </label>
                        </div>
                    </div>

                    <button class="btn btn-outline-secondary reset-filters" id="resetFilters">
                        <i class="bi bi-arrow-clockwise me-2"></i>Réinitialiser les filtres
                    </button>
                </div>

                <!-- Résumé de réservation -->
                <div class="booking-summary-card mt-4">
                    <h5 class="summary-title">Votre séjour</h5>
                    <div class="summary-item">
                        <span class="summary-label">Arrivée</span>
                        <span class="summary-value">{{ check_in_date|date('d/m/Y') }}</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Départ</span>
                        <span class="summary-value">{{ check_out_date|date('d/m/Y') }}</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Durée</span>
                        <span class="summary-value">
                            {% set difference = date(check_out_date).diff(date(check_in_date)) %}
                            {{ difference.days }} nuit(s)
                        </span>
                    </div>
                    <div class="summary-item summary-total">
                        <span>Prix total estimé</span>
                        <span id="estimatedTotal">-- TND</span>
                    </div>
                </div>
            </div>

            <!-- Contenu principal -->
            <div class="col-lg-9 col-md-8">
                <!-- En-tête -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1">Hôtels disponibles</h2>
                        <p class="text-muted mb-0">
                            <i class="bi bi-calendar-week me-1"></i>
                            {{ check_in_date|date('d/m/Y') }} - {{ check_out_date|date('d/m/Y') }}
                            • {{ hotels|length }} option(s) disponible(s)
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <!-- Toggle vue -->
                        <div class="view-toggle me-3">
                            <button class="btn btn-outline-secondary active" id="gridViewBtn" title="Vue grille">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </button>
                            <button class="btn btn-outline-secondary" id="listViewBtn" title="Vue liste">
                                <i class="bi bi-list"></i>
                            </button>
                        </div>
                        
                        <!-- Tri -->
                        <div class="sort-dropdown">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown">
                                    <i class="bi bi-sort-down me-2"></i>Trier par
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                                    <li><a class="dropdown-item" href="#" data-sort="price_asc">Prix (bas à haut)</a></li>
                                    <li><a class="dropdown-item" href="#" data-sort="price_desc">Prix (haut à bas)</a></li>
                                    <li><a class="dropdown-item" href="#" data-sort="rating">Meilleures notes</a></li>
                                    <li><a class="dropdown-item" href="#" data-sort="name">Nom (A-Z)</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Liste des hôtels (Vue grille par défaut) -->
                <div class="row grid-view" id="hotelsGrid">
                    {% for hotel in hotels %}
                        {% set totalPrice = hotel.pricePerNight * (date(check_out_date).diff(date(check_in_date)).days) %}
                        <div class="col-xl-4 col-lg-6 col-md-6 hotel-item" 
                             data-price="{{ hotel.pricePerNight }}"
                             data-rating="{{ hotel.rating|default(3) }}"
                             data-available="{{ hotel.availableRooms > 0 ? 'true' : 'false' }}">
                            <div class="hotel-card">
                                <!-- Badge de disponibilité -->
                                {% if hotel.availableRooms > 0 %}
                                    <div class="availability-badge">
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>{{ hotel.availableRooms }} chambre(s)
                                        </span>
                                    </div>
                                {% else %}
                                    <div class="availability-badge">
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Complet
                                        </span>
                                    </div>
                                {% endif %}

                                <!-- Images de l'hôtel -->
                                {% if hotel.imageUrl %}
                                    <div class="swiper swiper-hotel">
                                        <div class="swiper-wrapper">
                                            <div class="swiper-slide">
                                                <img src="{{ hotel.imageUrl }}" class="hotel-card-img" alt="{{ hotel.name }}" loading="lazy">
                                            </div>
                                            {% for i in range(1, 3) %}
                                            <div class="swiper-slide">
                                                <img src="https://source.unsplash.com/random/800x600/?hotel,{{ i }}" class="hotel-card-img" alt="{{ hotel.name }} - Image {{ i }}" loading="lazy">
                                            </div>
                                            {% endfor %}
                                        </div>
                                        <div class="swiper-pagination"></div>
                                        <div class="swiper-button-next"></div>
                                        <div class="swiper-button-prev"></div>
                                    </div>
                                {% else %}
                                    <div class="no-image-placeholder">
                                        <i class="bi bi-building"></i>
                                    </div>
                                {% endif %}

                                <!-- Détails de l'hôtel -->
                                <div class="hotel-details">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="hotel-name">{{ hotel.name }}</h5>
                                        <div class="rating-stars">
                                            {% set rating = hotel.rating|default(3) %}
                                            {% for i in range(1, 5) %}
                                                {% if i <= rating %}
                                                    <i class="bi bi-star-fill"></i>
                                                {% elseif i <= rating + 0.5 %}
                                                    <i class="bi bi-star-half"></i>
                                                {% else %}
                                                    <i class="bi bi-star"></i>
                                                {% endif %}
                                            {% endfor %}
                                            <span class="text-muted ms-1 small">({{ rating }})</span>
                                        </div>
                                    </div>
                                    
                                    <div class="hotel-location">
                                        <i class="bi bi-geo-alt me-1"></i>{{ hotel.address }}
                                    </div>
                                    
                                    <p class="card-text text-muted small mb-3">{{ hotel.description|slice(0, 100) }}...</p>
                                    
                                    <!-- Commodités -->
                                    <div class="amenities-list">
                                        <span class="amenity-badge">
                                            <i class="bi bi-wifi"></i> WiFi
                                        </span>
                                        <span class="amenity-badge">
                                            <i class="bi bi-cup-hot"></i> Petit-déjeuner
                                        </span>
                                        <span class="amenity-badge">
                                            <i class="bi bi-tv"></i> TV
                                        </span>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                        <div>
                                            <div class="price-tag">{{ hotel.pricePerNight }} TND</div>
                                            <div class="price-per-night">par nuit • {{ totalPrice }} TND total</div>
                                        </div>
                                        
                                        {% if hotel.availableRooms > 0 %}
                                            <a href="{{ path('app_select_hotel', {'hotelId': hotel.id}) }}" class="btn btn-primary">
                                                <i class="bi bi-eye me-1"></i>Selectionner l'hotel
                                            </a>
                                        {% else %}
                                            <button class="btn btn-secondary" disabled>
                                                <i class="bi bi-x-circle me-1"></i>Complet
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center py-5">
                                    <i class="bi bi-building-x display-1 text-muted mb-3"></i>
                                    <h3 class="text-muted mb-3">Aucun hôtel disponible</h3>
                                    <p class="text-muted mb-4">Aucun hôtel n'est disponible pour les dates sélectionnées. Veuillez essayer d'autres dates.</p>
                                    <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
                                        <i class="bi bi-arrow-left me-2"></i>Changer de dates
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Vue liste (cachée par défaut) -->
                <div class="list-view d-none" id="hotelsList">
                    {% for hotel in hotels %}
                        {% set totalPrice = hotel.pricePerNight * (date(check_out_date).diff(date(check_in_date)).days) %}
                        <div class="hotel-item" 
                             data-price="{{ hotel.pricePerNight }}"
                             data-rating="{{ hotel.rating|default(3) }}"
                             data-available="{{ hotel.availableRooms > 0 ? 'true' : 'false' }}">
                            <div class="hotel-card">
                                {% if hotel.availableRooms > 0 %}
                                    <div class="availability-badge">
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>{{ hotel.availableRooms }} chambre(s)
                                        </span>
                                    </div>
                                {% else %}
                                    <div class="availability-badge">
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Complet
                                        </span>
                                    </div>
                                {% endif %}

                                {% if hotel.imageUrl %}
                                    <div class="swiper swiper-hotel">
                                        <div class="swiper-wrapper">
                                            <div class="swiper-slide">
                                                <img src="{{ hotel.imageUrl }}" class="hotel-card-img" alt="{{ hotel.name }}" loading="lazy">
                                            </div>
                                            {% for i in range(1, 3) %}
                                            <div class="swiper-slide">
                                                <img src="https://source.unsplash.com/random/800x600/?hotel,{{ i }}" class="hotel-card-img" alt="{{ hotel.name }} - Image {{ i }}" loading="lazy">
                                            </div>
                                            {% endfor %}
                                        </div>
                                        <div class="swiper-pagination"></div>
                                        <div class="swiper-button-next"></div>
                                        <div class="swiper-button-prev"></div>
                                    </div>
                                {% else %}
                                    <div class="no-image-placeholder">
                                        <i class="bi bi-building"></i>
                                    </div>
                                {% endif %}

                                <div class="hotel-details">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="hotel-name">{{ hotel.name }}</h5>
                                            <div class="hotel-location">
                                                <i class="bi bi-geo-alt me-1"></i>{{ hotel.address }}
                                            </div>
                                        </div>
                                        <div class="rating-stars">
                                            {% set rating = hotel.rating|default(3) %}
                                            {% for i in range(1, 5) %}
                                                {% if i <= rating %}
                                                    <i class="bi bi-star-fill"></i>
                                                {% elseif i <= rating + 0.5 %}
                                                    <i class="bi bi-star-half"></i>
                                                {% else %}
                                                    <i class="bi bi-star"></i>
                                                {% endif %}
                                            {% endfor %}
                                            <span class="text-muted ms-1">({{ rating }})</span>
                                        </div>
                                    </div>
                                    
                                    <p class="card-text text-muted mb-3">{{ hotel.description|slice(0, 200) }}...</p>
                                    
                                    <div class="amenities-list">
                                        <span class="amenity-badge">
                                            <i class="bi bi-wifi"></i> WiFi gratuit
                                        </span>
                                        <span class="amenity-badge">
                                            <i class="bi bi-p-square"></i> Parking
                                        </span>
                                        <span class="amenity-badge">
                                            <i class="bi bi-droplet"></i> Piscine
                                        </span>
                                        <span class="amenity-badge">
                                            <i class="bi bi-cup-hot"></i> Petit-déjeuner
                                        </span>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                        <div>
                                            <div class="price-tag">{{ hotel.pricePerNight }} TND</div>
                                            <div class="price-per-night">par nuit • Total: {{ totalPrice }} TND</div>
                                        </div>
                                        
                                        {% if hotel.availableRooms > 0 %}
                                            <a href="{{ path('app_select_hotel', {'hotelId': hotel.id}) }}" class="btn btn-primary btn-lg">
                                                <i class="bi bi-eye me-1"></i>Voir les chambres
                                            </a>
                                        {% else %}
                                            <button class="btn btn-secondary btn-lg" disabled>
                                                <i class="bi bi-x-circle me-1"></i>Complet
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                {% if hotels|length > 12 %}
                <nav aria-label="Navigation des hôtels" class="mt-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                {% endif %}

                <!-- Bouton de retour -->
                <div class="mt-5 text-center">
                    <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i>
                        Retour à la sélection des villes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal pour les détails rapides -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Détails de l'hôtel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="quickViewContent">
                <!-- Contenu chargé dynamiquement -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialiser les Swipers pour les galeries d'images
            const swipers = document.querySelectorAll('.swiper-hotel');
            swipers.forEach(swiperEl => {
                new Swiper(swiperEl, {
                    loop: true,
                    pagination: {
                        el: swiperEl.querySelector('.swiper-pagination'),
                        clickable: true,
                    },
                    navigation: {
                        nextEl: swiperEl.querySelector('.swiper-button-next'),
                        prevEl: swiperEl.querySelector('.swiper-button-prev'),
                    },
                    autoplay: {
                        delay: 3000,
                        disableOnInteraction: false,
                    },
                });
            });

            // Gestion des vues (grille/liste)
            const gridViewBtn = document.getElementById('gridViewBtn');
            const listViewBtn = document.getElementById('listViewBtn');
            const hotelsGrid = document.getElementById('hotelsGrid');
            const hotelsList = document.getElementById('hotelsList');

            gridViewBtn.addEventListener('click', function() {
                this.classList.add('active');
                listViewBtn.classList.remove('active');
                hotelsGrid.classList.remove('d-none');
                hotelsList.classList.add('d-none');
            });

            listViewBtn.addEventListener('click', function() {
                this.classList.add('active');
                gridViewBtn.classList.remove('active');
                hotelsGrid.classList.add('d-none');
                hotelsList.classList.remove('d-none');
            });

            // Filtrage des hôtels
            const hotelItems = document.querySelectorAll('.hotel-item');
            const priceRange = document.getElementById('priceRange');
            const minPriceSpan = document.getElementById('minPrice');
            const maxPriceSpan = document.getElementById('maxPrice');
            const availableOnlyCheckbox = document.getElementById('availableOnly');
            const resetFiltersBtn = document.getElementById('resetFilters');
            const starCheckboxes = document.querySelectorAll('.star-rating-filter input[type="checkbox"]');
            const amenityCheckboxes = document.querySelectorAll('.amenities-filter input[type="checkbox"]');
            const sortDropdownItems = document.querySelectorAll('[data-sort]');

            // Calculer le prix maximum réel
            let maxHotelPrice = 0;
            hotelItems.forEach(item => {
                const price = parseFloat(item.dataset.price);
                if (price > maxHotelPrice) maxHotelPrice = price;
            });

            // Mettre à jour la plage de prix
            priceRange.max = Math.ceil(maxHotelPrice / 50) * 50;
            maxPriceSpan.textContent = priceRange.max + ' TND';

            // Mettre à jour le prix estimé total
            function updateEstimatedTotal() {
                const duration = {{ date(check_out_date).diff(date(check_in_date)).days }};
                let total = 0;
                let count = 0;
                
                document.querySelectorAll('.hotel-item:not(.d-none)').forEach(item => {
                    if (item.dataset.available === 'true') {
                        total += parseFloat(item.dataset.price) * duration;
                        count++;
                    }
                });
                
                const estimatedTotal = document.getElementById('estimatedTotal');
                if (count > 0) {
                    estimatedTotal.textContent = Math.round(total / count) + ' TND';
                } else {
                    estimatedTotal.textContent = '-- TND';
                }
            }

            // Fonction de filtrage
            function filterHotels() {
                const maxPrice = parseInt(priceRange.value);
                const showAvailableOnly = availableOnlyCheckbox.checked;
                
                // Récupérer les étoiles sélectionnées
                const selectedStars = [];
                starCheckboxes.forEach(cb => {
                    if (cb.checked) selectedStars.push(parseInt(cb.dataset.rating));
                });
                
                // Récupérer les commodités sélectionnées
                const selectedAmenities = [];
                amenityCheckboxes.forEach(cb => {
                    if (cb.checked) selectedAmenities.push(cb.id.replace('Filter', ''));
                });

                hotelItems.forEach(item => {
                    const price = parseFloat(item.dataset.price);
                    const rating = parseFloat(item.dataset.rating);
                    const isAvailable = item.dataset.available === 'true';
                    
                    let shouldShow = true;
                    
                    // Filtre par prix
                    if (price > maxPrice) {
                        shouldShow = false;
                    }
                    
                    // Filtre par disponibilité
                    if (showAvailableOnly && !isAvailable) {
                        shouldShow = false;
                    }
                    
                    // Filtre par étoiles
                    if (selectedStars.length > 0) {
                        const matchesStar = selectedStars.some(star => rating >= star);
                        if (!matchesStar) shouldShow = false;
                    }
                    
                    // Mettre à jour l'affichage
                    if (shouldShow) {
                        item.classList.remove('d-none');
                    } else {
                        item.classList.add('d-none');
                    }
                });
                
                updateEstimatedTotal();
                updateHotelCount();
            }

            // Mettre à jour le compteur d'hôtels
            function updateHotelCount() {
                const visibleCount = document.querySelectorAll('.hotel-item:not(.d-none)').length;
                const countBadge = document.querySelector('.hotel-count-badge');
                if (countBadge) {
                    countBadge.textContent = visibleCount + ' hôtel(s) trouvé(s)';
                }
            }

            // Trier les hôtels
            function sortHotels(criteria) {
                const container = document.querySelector(hotelsGrid.classList.contains('d-none') ? '#hotelsList' : '#hotelsGrid');
                const items = Array.from(container.querySelectorAll('.hotel-item'));
                
                items.sort((a, b) => {
                    switch(criteria) {
                        case 'price_asc':
                            return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                        case 'price_desc':
                            return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                        case 'rating':
                            return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
                        case 'name':
                            return a.querySelector('.hotel-name').textContent.localeCompare(
                                b.querySelector('.hotel-name').textContent
                            );
                        default:
                            return 0;
                    }
                });
                
                // Réorganiser les éléments
                items.forEach(item => container.appendChild(item));
            }

            // Événements
            priceRange.addEventListener('input', function() {
                minPriceSpan.textContent = '0 TND';
                maxPriceSpan.textContent = this.value + ' TND';
                filterHotels();
            });

            availableOnlyCheckbox.addEventListener('change', filterHotels);
            starCheckboxes.forEach(cb => cb.addEventListener('change', filterHotels));
            amenityCheckboxes.forEach(cb => cb.addEventListener('change', filterHotels));

            resetFiltersBtn.addEventListener('click', function() {
                priceRange.value = priceRange.max;
                minPriceSpan.textContent = '0 TND';
                maxPriceSpan.textContent = priceRange.max + ' TND';
                availableOnlyCheckbox.checked = true;
                starCheckboxes.forEach(cb => cb.checked = false);
                amenityCheckboxes.forEach(cb => cb.checked = false);
                filterHotels();
            });

            sortDropdownItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    sortHotels(this.dataset.sort);
                    document.getElementById('sortDropdown').textContent = this.textContent + ' ▾';
                });
            });

            // Initialiser
            updateEstimatedTotal();
            filterHotels();

            // Affichage rapide au survol (optionnel)
            const quickViewModal = new bootstrap.Modal(document.getElementById('quickViewModal'));
            
            hotelItems.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    // Précharger les données pour l'affichage rapide
                    // Cette fonctionnalité pourrait être ajoutée si nécessaire
                });
            });

            // Animation d'apparition progressive
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);

            hotelItems.forEach(item => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(item);
            });
        });
    </script>
{% endblock %}