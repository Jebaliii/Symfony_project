{% extends "base.html.twig" %}

{% block title %}Sélection des Dates - Système de Réservation{% endblock %}

{% block body %}
<div class="dates-page">
    <!-- Arrière-plan avec éléments décoratifs -->
    <div class="background-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
    </div>

    <div class="container-fluid">
        <div class="row justify-content-center align-items-center min-vh-100">
            <!-- Colonne de présentation à gauche -->
            <div class="col-lg-6 d-none d-lg-block presentation-column">
                <div class="presentation-content">
                    <div class="brand-section mb-5">
                        <div class="logo-container mb-4">
                            <div class="logo-icon">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <h1 class="brand-name">Booking<span>Pro</span></h1>
                        </div>
                        <h2 class="display-5 fw-bold text-white mb-4">
                            Réservez votre séjour à<br>{{ city.name }}
                        </h2>
                        <p class="lead text-light opacity-75">
                            Choisissez vos dates et découvrez les meilleurs hôtels<br>
                            disponibles pour votre séjour.
                        </p>
                    </div>

                    <!-- Info sur la ville -->
                    <div class="city-info-card mb-5">
                        <div class="card border-0 bg-light bg-opacity-10 backdrop-blur">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="city-icon me-3">
                                        <i class="bi bi-geo-alt-fill text-white fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="text-white mb-1">Destination sélectionnée</h5>
                                        <h3 class="text-white fw-bold">{{ city.name }}</h3>
                                    </div>
                                </div>
                                <div class="city-details">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="detail-item mb-3">
                                                <i class="bi bi-thermometer-sun text-warning me-2"></i>
                                                <span class="text-light">Climat favorable</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="detail-item mb-3">
                                                <i class="bi bi-currency-euro text-success me-2"></i>
                                                <span class="text-light">Prix compétitifs</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="detail-item mb-3">
                                                <i class="bi bi-star-fill text-warning me-2"></i>
                                                <span class="text-light">Hôtels 4-5 étoiles</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="detail-item mb-3">
                                                <i class="bi bi-wifi text-info me-2"></i>
                                                <span class="text-light">WiFi gratuit</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Avantages -->
                    <div class="benefits-list">
                        <h5 class="text-white mb-4"><i class="bi bi-check-circle-fill text-success me-2"></i>Pourquoi réserver maintenant ?</h5>
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div class="benefit-text">
                                <h6 class="text-white mb-1">Meilleur prix garanti</h6>
                                <p class="text-light opacity-75 mb-0">Réservez aujourd'hui et économisez jusqu'à 30%</p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="benefit-text">
                                <h6 class="text-white mb-1">Annulation gratuite</h6>
                                <p class="text-light opacity-75 mb-0">Annulez jusqu'à 24h avant votre arrivée</p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="bi bi-award"></i>
                            </div>
                            <div class="benefit-text">
                                <h6 class="text-white mb-1">Service premium</h6>
                                <p class="text-light opacity-75 mb-0">Assistance 24/7 pendant votre séjour</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne de sélection des dates à droite -->
            <div class="col-lg-6 col-md-8">
                <div class="dates-container">
                    <div class="dates-card">
                        <!-- En-tête de la carte -->
                        <div class="dates-header text-center mb-5">
                            <h3 class="dates-title">Sélectionnez vos dates</h3>
                            <p class="text-muted">Choisissez vos dates d'arrivée et de départ</p>
                            <div class="booking-progress">
                                <div class="progress-steps">
                                    <div class="step active">
                                        <div class="step-circle">1</div>
                                        <div class="step-label">Ville</div>
                                    </div>
                                    <div class="step-line active"></div>
                                    <div class="step active">
                                        <div class="step-circle">2</div>
                                        <div class="step-label">Dates</div>
                                    </div>
                                    <div class="step-line"></div>
                                    <div class="step">
                                        <div class="step-circle">3</div>
                                        <div class="step-label">Hôtel</div>
                                    </div>
                                    <div class="step-line"></div>
                                    <div class="step">
                                        <div class="step-circle">4</div>
                                        <div class="step-label">Confirmation</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Indicateur de ville sélectionnée -->
                        <div class="selected-city-indicator mb-4">
                            <div class="alert alert-primary border-0 bg-light" role="alert">
                                <div class="d-flex align-items-center">
                                    <div class="alert-icon me-3">
                                        <i class="bi bi-geo-alt-fill text-primary fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="alert-heading mb-1">Destination : {{ city.name }}</h5>
                                        <p class="mb-0 text-muted">Vous êtes à une étape de trouver l'hôtel parfait pour votre séjour</p>
                                    </div>
                                    <div class="city-badge">
                                        <span class="badge bg-primary">Sélectionné</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Formulaire de sélection des dates -->
                        <form method="POST" action="{{ path('app_select_date') }}" class="dates-form" id="datesForm">
                            <div class="row g-4">
                                <!-- Date d'arrivée -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="form-label-wrapper">
                                            <label for="check_in_date" class="form-label fw-semibold">
                                                <i class="bi bi-calendar-plus me-2"></i>Date d'arrivée
                                            </label>
                                            <span class="required-badge">Requis</span>
                                        </div>
                                        <div class="input-group date-input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="bi bi-box-arrow-in-right text-muted"></i>
                                            </span>
                                            <input type="date" 
                                                   id="check_in_date" 
                                                   name="check_in_date" 
                                                   class="form-control form-control-lg date-picker" 
                                                   required 
                                                   min="{{ 'now'|date('Y-m-d') }}"
                                                   value="{{ app.request.query.get('check_in_date', '') }}">
                                            <div class="input-group-text date-preview border-start-0">
                                                <span id="checkInPreview">--/--/----</span>
                                            </div>
                                        </div>
                                        <div class="form-text">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Sélectionnez votre date d'arrivée
                                        </div>
                                        <div class="date-suggestions mt-2">
                                            <small class="text-muted">Suggestions :</small>
                                            <div class="btn-group btn-group-sm mt-1" role="group">
                                                <button type="button" class="btn btn-outline-primary suggestion-btn" data-days="0">Aujourd'hui</button>
                                                <button type="button" class="btn btn-outline-primary suggestion-btn" data-days="7">Dans 7 jours</button>
                                                <button type="button" class="btn btn-outline-primary suggestion-btn" data-days="14">Dans 14 jours</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Date de départ -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="form-label-wrapper">
                                            <label for="check_out_date" class="form-label fw-semibold">
                                                <i class="bi bi-calendar-minus me-2"></i>Date de départ
                                            </label>
                                            <span class="required-badge">Requis</span>
                                        </div>
                                        <div class="input-group date-input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="bi bi-box-arrow-left text-muted"></i>
                                            </span>
                                            <input type="date" 
                                                   id="check_out_date" 
                                                   name="check_out_date" 
                                                   class="form-control form-control-lg date-picker" 
                                                   required 
                                                   min="{{ 'now'|date('Y-m-d') }}"
                                                   value="{{ app.request.query.get('check_out_date', '') }}">
                                            <div class="input-group-text date-preview border-start-0">
                                                <span id="checkOutPreview">--/--/----</span>
                                            </div>
                                        </div>
                                        <div class="form-text">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Sélectionnez votre date de départ
                                        </div>
                                        <div class="duration-info mt-2">
                                            <div id="durationDisplay" class="text-muted small">
                                                <i class="bi bi-clock me-1"></i>
                                                Durée du séjour : <span id="durationValue">--</span> nuit(s)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Résumé des dates -->
                            <div class="date-summary-card mt-4">
                                <div class="card border-0 bg-light">
                                    <div class="card-body p-3">
                                        <div class="row text-center">
                                            <div class="col-6">
                                                <div class="date-summary">
                                                    <div class="summary-label text-muted small">Arrivée</div>
                                                    <div class="summary-value fw-bold" id="arrivalDate">--/--/----</div>
                                                    <div class="summary-extra text-muted small" id="arrivalDay">--</div>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="date-summary">
                                                    <div class="summary-label text-muted small">Départ</div>
                                                    <div class="summary-value fw-bold" id="departureDate">--/--/----</div>
                                                    <div class="summary-extra text-muted small" id="departureDay">--</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-center mt-3">
                                            <div class="total-nights">
                                                <i class="bi bi-moon-stars text-primary me-2"></i>
                                                <span class="fw-semibold" id="totalNights">0</span> nuit(s) à {{ city.name }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Validation de la période -->
                            <div id="dateValidation" class="mt-3 d-none">
                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <div id="validationMessage"></div>
                                </div>
                            </div>

                            <!-- Boutons d'action -->
                            <div class="d-grid gap-3 mt-5">
                                <button type="submit" class="btn btn-primary btn-lg search-btn">
                                    <i class="bi bi-search me-2"></i>
                                    <span class="btn-text">Rechercher les hôtels disponibles</span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                </button>
                                
                                <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-arrow-left me-2"></i>
                                    Changer de destination
                                </a>
                            </div>

                            <!-- Information additionnelle -->
                            <div class="additional-info mt-4 pt-4 border-top text-center">
                                <small class="text-muted">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Réservation flexible &nbsp;•&nbsp; 
                                    <i class="bi bi-shield-lock me-1"></i>
                                    Paiement sécurisé &nbsp;•&nbsp;
                                    <i class="bi bi-headset me-1"></i>
                                    Support 24/7
                                </small>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
