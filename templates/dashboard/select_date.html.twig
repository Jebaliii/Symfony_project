</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Références aux éléments
    const checkInInput = document.getElementById('check_in_date');
    const checkOutInput = document.getElementById('check_out_date');
    const checkInPreview = document.getElementById('checkInPreview');
    const checkOutPreview = document.getElementById('checkOutPreview');
    const arrivalDate = document.getElementById('arrivalDate');
    const departureDate = document.getElementById('departureDate');
    const arrivalDay = document.getElementById('arrivalDay');
    const departureDay = document.getElementById('departureDay');
    const durationValue = document.getElementById('durationValue');
    const totalNights = document.getElementById('totalNights');
    const validationDiv = document.getElementById('dateValidation');
    const validationMessage = document.getElementById('validationMessage');
    const searchBtn = document.querySelector('.search-btn');
    const btnText = searchBtn.querySelector('.btn-text');
    const spinner = searchBtn.querySelector('.spinner-border');
    const form = document.getElementById('datesForm');
    
    // Formatteur de date
    const daysOfWeek = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
    const months = ['Janv', 'Fév', 'Mars', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sept', 'Oct', 'Nov', 'Déc'];
    
    function formatDate(dateString) {
        if (!dateString) return '--/--/----';
        const date = new Date(dateString);
        const day = date.getDate().toString().padStart(2, '0');
        const month = (date.getMonth() + 1).toString().padStart(2, '0');
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
    }
    
    function formatDateLong(dateString) {
        if (!dateString) return '--/--/----';
        const date = new Date(dateString);
        const day = date.getDate();
        const month = months[date.getMonth()];
        const year = date.getFullYear();
        return `${day} ${month} ${year}`;
    }
    
    function getDayName(dateString) {
        if (!dateString) return '--';
        const date = new Date(dateString);
        return daysOfWeek[date.getDay()];
    }
    
    function calculateDuration(startDate, endDate) {
        if (!startDate || !endDate) return 0;
        const start = new Date(startDate);
        const end = new Date(endDate);
        const diffTime = Math.abs(end - start);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        return diffDays;
    }
    
    function updateDateDisplay() {
        const checkIn = checkInInput.value;
        const checkOut = checkOutInput.value;
        
        // Mettre à jour les prévisualisations
        checkInPreview.textContent = formatDate(checkIn);
        checkOutPreview.textContent = formatDate(checkOut);
        
        // Mettre à jour le résumé
        arrivalDate.textContent = formatDateLong(checkIn);
        departureDate.textContent = formatDateLong(checkOut);
        arrivalDay.textContent = getDayName(checkIn);
        departureDay.textContent = getDayName(checkOut);
        
        // Calculer et afficher la durée
        const duration = calculateDuration(checkIn, checkOut);
        durationValue.textContent = duration;
        totalNights.textContent = duration;
        
        // Valider les dates
        validateDates(checkIn, checkOut);
    }
    
    function validateDates(checkIn, checkOut) {
        validationDiv.classList.add('d-none');
        searchBtn.disabled = false;
        
        if (!checkIn || !checkOut) {
            searchBtn.disabled = true;
            return;
        }
        
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        
        const startDate = new Date(checkIn);
        const endDate = new Date(checkOut);
        
        // Validation de base
        if (startDate < today) {
            showValidationError("La date d'arrivée ne peut pas être dans le passé.");
            searchBtn.disabled = true;
            return;
        }
        
        if (endDate <= startDate) {
            showValidationError("La date de départ doit être après la date d'arrivée.");
            searchBtn.disabled = true;
            return;
        }
        
        if (calculateDuration(checkIn, checkOut) < 1) {
            showValidationError("La durée minimale du séjour est d'une nuit.");
            searchBtn.disabled = true;
            return;
        }
        
        if (calculateDuration(checkIn, checkOut) > 30) {
            showValidationError("La durée maximale du séjour est de 30 nuits.");
            searchBtn.disabled = true;
            return;
        }
    }
    
    function showValidationError(message) {
        validationMessage.textContent = message;
        validationDiv.classList.remove('d-none');
    }
    
    // Gestionnaires d'événements
    checkInInput.addEventListener('change', function() {
        // Définir la date de départ minimum
        if (this.value) {
            const minDate = new Date(this.value);
            minDate.setDate(minDate.getDate() + 1);
            checkOutInput.min = minDate.toISOString().split('T')[0];
            
            // Si la date de départ est antérieure à la nouvelle date d'arrivée, la réinitialiser
            if (checkOutInput.value && new Date(checkOutInput.value) <= new Date(this.value)) {
                checkOutInput.value = '';
            }
        }
        updateDateDisplay();
    });
    
    checkOutInput.addEventListener('change', updateDateDisplay);
    
    // Boutons de suggestion de dates
    document.querySelectorAll('.suggestion-btn').forEach(button => {
        button.addEventListener('click', function() {
            const daysToAdd = parseInt(this.getAttribute('data-days'));
            const today = new Date();
            today.setDate(today.getDate() + daysToAdd);
            
            // Formater la date pour l'input
            const formattedDate = today.toISOString().split('T')[0];
            checkInInput.value = formattedDate;
            
            // Définir la date de départ (arrivée + 1 jour)
            const checkoutDate = new Date(today);
            checkoutDate.setDate(checkoutDate.getDate() + 1);
            checkOutInput.value = checkoutDate.toISOString().split('T')[0];
            
            // Mettre à jour l'affichage
            updateDateDisplay();
        });
    });
    
    // Soumission du formulaire
    form.addEventListener('submit', function(e) {
        const checkIn = checkInInput.value;
        const checkOut = checkOutInput.value;
        
        if (!checkIn || !checkOut) {
            e.preventDefault();
            showValidationError("Veuillez sélectionner les dates d'arrivée et de départ.");
            return;
        }
        
        if (new Date(checkOut) <= new Date(checkIn)) {
            e.preventDefault();
            showValidationError("La date de départ doit être après la date d'arrivée.");
            return;
        }
        
        // Afficher l'état de chargement
        btnText.classList.add('d-none');
        spinner.classList.remove('d-none');
        searchBtn.disabled = true;
        
        // Réinitialiser après 5 secondes (au cas où)
        setTimeout(() => {
            btnText.classList.remove('d-none');
            spinner.classList.add('d-none');
            searchBtn.disabled = false;
        }, 5000);
    });
    
    // Initialiser l'affichage avec les valeurs existantes
    updateDateDisplay();
    
    // Animer les éléments
    const benefits = document.querySelectorAll('.benefit-item');
    benefits.forEach((benefit, index) => {
        benefit.style.animationDelay = `${index * 0.2}s`;
    });
});
</script>
{% endblock %}