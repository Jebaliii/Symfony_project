}

.dates-header {
    margin-bottom: 2rem;
}

.dates-title {
    font-size: 2rem;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 0.5rem;
}

.booking-progress {
    margin: 2rem 0;
}

.progress-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.step {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
}

.step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #64748b;
    display: flex;
    align-items: center;
