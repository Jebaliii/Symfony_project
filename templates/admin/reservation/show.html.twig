{% extends 'base.html.twig' %}

{% block title %}Reservation #{{ reservation.id }}{% endblock %}

{% block body %}
<div class="reservation-detail-wrapper">
    <!-- HEADER SECTION WITH RESERVATION INFO -->
    <div class="reservation-header">
        <div class="reservation-header-content">
            <div class="reservation-header-info">
                <i class="bi bi-calendar-check"></i>
                <div>
                    <h1>Reservation #{{ reservation.id }}</h1>
                    <div class="reservation-meta">
                        <span class="reservation-user">
                            <i class="bi bi-person"></i> {{ reservation.user.email }}
                        </span>
                    </div>
                </div>
            </div>
            <span class="status-badge-header {% if reservation.status == 'confirmed' %}status-confirmed{% elseif reservation.status == 'pending' %}status-pending{% elseif reservation.status == 'cancelled' %}status-cancelled{% endif %}">
                <i class="bi {% if reservation.status == 'confirmed' %}bi-check-circle{% elseif reservation.status == 'pending' %}bi-clock{% else %}bi-x-circle{% endif %}"></i>
                {{ reservation.status|capitalize }}
            </span>
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="reservation-container">
        <div class="reservation-grid">
            <!-- LEFT COLUMN - MAIN INFO -->
            <div class="reservation-main">
                <!-- HOTEL INFO CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-building"></i> Hotel Information</h2>
                    </div>
                    <div class="card-body">
                        <div class="info-item">
                            <span class="label">Hotel Name:</span>
                            <span class="value">{{ reservation.hotel.name }}</span>
                        </div>
                        {% if reservation.hotel.address %}
                        <div class="info-item">
                            <span class="label">Address:</span>
                            <span class="value">{{ reservation.hotel.address }}</span>
                        </div>
                        {% endif %}
                        {% if reservation.hotel.pricePerNight %}
                        <div class="info-item">
                            <span class="label">Price per Night:</span>
                            <span class="value price-highlight">{{ reservation.hotel.pricePerNight }} TND</span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- DATES CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-calendar"></i> Reservation Dates</h2>
                    </div>
                    <div class="card-body">
                        <div class="dates-grid">
                            <div class="date-item">
                                <span class="date-label">Check-in</span>
                                <span class="date-value">{{ reservation.checkInDate ? reservation.checkInDate|date('D, M d Y') : 'N/A' }}</span>
                            </div>
                            <div class="date-item">
                                <span class="date-label">Check-out</span>
                                <span class="date-value">{{ reservation.checkOutDate ? reservation.checkOutDate|date('D, M d Y') : 'N/A' }}</span>
                            </div>
                        </div>
                        {% if reservation.checkInDate and reservation.checkOutDate %}
                        <div class="info-item" style="margin-top: 15px;">
                            <span class="label">Duration:</span>
                            <span class="value">{{ (reservation.checkOutDate.diff(reservation.checkInDate).days) }} nights</span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- USER INFO CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-person-circle"></i> Guest Information</h2>
                    </div>
                    <div class="card-body">
                        <div class="info-item">
                            <span class="label">Email:</span>
                            <span class="value">{{ reservation.user.email }}</span>
                        </div>
                        {% if reservation.user.firstName is defined %}
                        <div class="info-item">
                            <span class="label">Name:</span>
                            <span class="value">{{ reservation.user.firstName }} {{ reservation.user.lastName ?? '' }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN - SIDE INFO -->
            <div class="reservation-sidebar">
                <!-- PAYMENT CARD -->
                <div class="info-card sticky-card">
                    <div class="card-header">
                        <h2><i class="bi bi-credit-card"></i> Payment</h2>
                    </div>
                    <div class="card-body">
                        <div class="payment-info">
                            {% if reservation.paymentMethod %}
                            <div class="info-item">
                                <span class="label">Method:</span>
                                <span class="value">{{ reservation.paymentMethod|capitalize }}</span>
                            </div>
                            {% endif %}
                            {% if reservation.checkInDate and reservation.checkOutDate and reservation.hotel.pricePerNight %}
                            <div class="info-item" style="margin-top: 15px; border-top: 1px solid #e0e0e0; padding-top: 15px;">
                                <span class="label">Total Price:</span>
                                <span class="value price-total">{{ (reservation.checkOutDate.diff(reservation.checkInDate).days * reservation.hotel.pricePerNight)|round(2) }} TND</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- STATUS CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-info-circle"></i> Status</h2>
                    </div>
                    <div class="card-body">
                        <div class="status-display">
                            <span class="status-badge-large {% if reservation.status == 'confirmed' %}status-confirmed{% elseif reservation.status == 'pending' %}status-pending{% elseif reservation.status == 'cancelled' %}status-cancelled{% endif %}">
                                {{ reservation.status|capitalize }}
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ACTIONS CARD -->
                <div class="actions-card">
                    <div class="card-body">
                        <a href="{{ path('admin_reservation_edit', {id: reservation.id}) }}" class="btn-action btn-edit">
                            <i class="bi bi-pencil-square"></i>
                            <span>Edit</span>
                        </a>
                        <a href="{{ path('admin_reservation_index') }}" class="btn-action btn-back">
                            <i class="bi bi-arrow-left"></i>
                            <span>Back</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --danger-color: #dc3545;
        --warning-color: #ffc107;
        --text-primary: #2c3e50;
        --text-secondary: #7f8c8d;
        --bg-light: #f5f7fb;
        --border-color: #e0e0e0;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
    }

    .reservation-detail-wrapper {
        background-color: var(--bg-light);
        min-height: 100vh;
        padding: 30px 20px;
    }

    /* HEADER */
    .reservation-header {
        background: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: var(--shadow-sm);
    }

    .reservation-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .reservation-header-info {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        flex: 1;
    }

    .reservation-header-info i {
        font-size: 40px;
        color: var(--primary-color);
        margin-top: 5px;
    }

    .reservation-header-info h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .reservation-meta {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .reservation-user {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .reservation-user i {
        font-size: 16px;
        color: var(--primary-color);
    }

    .status-badge-header {
        padding: 10px 18px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .status-badge-header.status-confirmed {
        background: #d4edda;
        color: #155724;
    }

    .status-badge-header.status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-badge-header.status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    /* CONTAINER */
    .reservation-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .reservation-grid {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 30px;
    }

    .reservation-main {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .reservation-sidebar {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* CARDS */
    .info-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .info-card:hover {
        box-shadow: var(--shadow-md);
    }

    .sticky-card {
        position: sticky;
        top: 20px;
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card-header h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body {
        padding: 24px;
    }

    /* INFO ITEMS */
    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-item .label {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 13px;
    }

    .info-item .value {
        color: var(--text-secondary);
        font-size: 14px;
    }

    .price-highlight {
        color: var(--primary-color);
        font-weight: 600;
        font-size: 16px;
    }

    /* DATES GRID */
    .dates-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .date-item {
        text-align: center;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .date-label {
        display: block;
        font-size: 12px;
        color: var(--text-secondary);
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .date-value {
        display: block;
        font-size: 14px;
        color: var(--text-primary);
        font-weight: 600;
    }

    /* PAYMENT INFO */
    .payment-info {
        text-align: center;
    }

    .price-total {
        display: block;
        font-size: 24px;
        font-weight: 700;
        color: var(--primary-color);
    }

    /* STATUS DISPLAY */
    .status-display {
        text-align: center;
    }

    .status-badge-large {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        text-transform: capitalize;
    }

    .status-badge-large.status-confirmed {
        background: #d4edda;
        color: #155724;
    }

    .status-badge-large.status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-badge-large.status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    /* ACTIONS */
    .actions-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .actions-card .card-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 16px;
    }

    .btn-action {
        padding: 12px 16px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        border: 1.5px solid transparent;
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
    }

    .btn-back {
        background: white;
        color: var(--text-secondary);
        border: 1.5px solid var(--border-color);
    }

    .btn-back:hover {
        border-color: var(--text-secondary);
        background: var(--bg-light);
        color: var(--text-primary);
    }

    /* RESPONSIVE */
    @media (max-width: 992px) {
        .reservation-grid {
            grid-template-columns: 1fr;
        }

        .sticky-card {
            position: static;
        }

        .reservation-header-content {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @media (max-width: 768px) {
        .reservation-detail-wrapper {
            padding: 20px 15px;
        }

        .reservation-header {
            padding: 20px;
        }

        .reservation-header-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .reservation-header-info i {
            font-size: 32px;
        }

        .reservation-header-info h1 {
            font-size: 24px;
        }

        .card-body {
            padding: 16px;
        }

        .dates-grid {
            grid-template-columns: 1fr;
        }

        .actions-card .card-body {
            flex-direction: column;
        }

        .btn-action {
            width: 100%;
        }
    }

    @media (max-width: 480px) {
        .reservation-detail-wrapper {
            padding: 15px 10px;
        }

        .reservation-header {
            padding: 15px;
        }

        .reservation-header-info h1 {
            font-size: 20px;
        }

        .reservation-header-info i {
            font-size: 28px;
        }

        .price-total {
            font-size: 20px;
        }

        .date-value {
            font-size: 12px;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}
