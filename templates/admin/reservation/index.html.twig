{% extends 'base.html.twig' %}

{% block title %}Reservations Management{% endblock %}

{% block body %}
<div class="reservations-wrapper">
    <!-- HEADER SECTION -->
    <div class="reservations-header">
        <div class="header-top">
            <div class="header-info">
                <i class="bi bi-calendar-check"></i>
                <div>
                    <h1>Reservations Management</h1>
                    <p>Manage all your reservations efficiently</p>
                </div>
            </div>
            <a href="{{ path('admin_reservation_new') }}" class="btn-create-new">
                <i class="bi bi-plus-lg"></i>
                <span>New Reservation</span>
            </a>
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="reservations-container">
        <!-- STATS CARDS -->
        {% set totalReservations = reservations|length %}
        {% set confirmedCount = 0 %}
        {% set pendingCount = 0 %}
        {% for res in reservations %}
            {% if res.status == 'confirmed' %}
                {% set confirmedCount = confirmedCount + 1 %}
            {% elseif res.status == 'pending' %}
                {% set pendingCount = pendingCount + 1 %}
            {% endif %}
        {% endfor %}

        <div class="stats-section">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Reservations</span>
                    <span class="stat-value">{{ totalReservations }}</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Confirmed</span>
                    <span class="stat-value">{{ confirmedCount }}</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Pending</span>
                    <span class="stat-value">{{ pendingCount }}</span>
                </div>
            </div>
        </div>

        <!-- RESERVATIONS TABLE -->
        {% if reservations|length > 0 %}
        <div class="table-card">
            <div class="table-header">
                <h2>Reservations List</h2>
                <p>{{ reservations|length }} reservation{{ reservations|length > 1 ? 's' : '' }} found</p>
            </div>

            <div class="table-responsive">
                <table class="reservations-table">
                    <thead>
                        <tr>
                            <th>
                                <i class="bi bi-person"></i>
                                User
                            </th>
                            <th>
                                <i class="bi bi-building"></i>
                                Hotel
                            </th>
                            <th>
                                <i class="bi bi-calendar"></i>
                                Check-in
                            </th>
                            <th>
                                <i class="bi bi-calendar"></i>
                                Check-out
                            </th>
                            <th>
                                <i class="bi bi-tag"></i>
                                Status
                            </th>
                            <th class="actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for res in reservations %}
                        <tr class="table-row">
                            <td class="user-email">
                                <strong>{{ res.user.email }}</strong>
                            </td>
                            <td class="hotel-name">
                                {{ res.hotel.name }}
                            </td>
                            <td class="checkin-date">
                                <span class="date-badge">{{ res.checkInDate ? res.checkInDate|date('Y-m-d') : 'N/A' }}</span>
                            </td>
                            <td class="checkout-date">
                                <span class="date-badge">{{ res.checkOutDate ? res.checkOutDate|date('Y-m-d') : 'N/A' }}</span>
                            </td>
                            <td class="status-cell">
                                {% if res.status == 'confirmed' %}
                                    <span class="status-badge status-confirmed">
                                        <i class="bi bi-check-circle"></i> Confirmed
                                    </span>
                                {% elseif res.status == 'pending' %}
                                    <span class="status-badge status-pending">
                                        <i class="bi bi-clock"></i> Pending
                                    </span>
                                {% elseif res.status == 'cancelled' %}
                                    <span class="status-badge status-cancelled">
                                        <i class="bi bi-x-circle"></i> Cancelled
                                    </span>
                                {% else %}
                                    <span class="status-badge status-default">
                                        {{ res.status|capitalize }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="actions-cell">
                                <div class="action-buttons">
                                    <a href="{{ path('admin_reservation_show', {id: res.id}) }}" class="btn-action btn-view" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_reservation_edit', {id: res.id}) }}" class="btn-action btn-edit" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin_reservation_delete', {id: res.id}) }}" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this reservation?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-reservation-' ~ res.id) }}">
                                        <button type="submit" class="btn-action btn-delete" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% else %}
        <!-- EMPTY STATE -->
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <h2>No Reservations Yet</h2>
            <p>Start by creating your first reservation</p>
            <a href="{{ path('admin_reservation_new') }}" class="btn-create-new btn-lg">
                <i class="bi bi-plus-lg"></i>
                <span>Create First Reservation</span>
            </a>
        </div>
        {% endif %}
    </div>
</div>

<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --danger-color: #dc3545;
        --warning-color: #ffc107;
        --text-primary: #2c3e50;
        --text-secondary: #7f8c8d;
        --bg-light: #f5f7fb;
        --border-color: #e0e0e0;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
    }

    .reservations-wrapper {
        background-color: var(--bg-light);
        min-height: 100vh;
        padding: 30px 20px;
    }

    /* HEADER */
    .reservations-header {
        background: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: var(--shadow-sm);
    }

    .header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .header-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-info i {
        font-size: 40px;
        color: var(--primary-color);
    }

    .header-info h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .header-info p {
        margin: 0;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .btn-create-new {
        padding: 12px 24px;
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-create-new:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        color: white;
        text-decoration: none;
    }

    .btn-create-new.btn-lg {
        padding: 16px 32px;
        font-size: 16px;
    }

    /* CONTAINER */
    .reservations-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* STATS SECTION */
    .stats-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        border-radius: 12px;
        font-size: 24px;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 12px;
        color: var(--text-secondary);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
    }

    /* TABLE CARD */
    .table-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .table-header {
        padding: 24px;
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
    }

    .table-header h2 {
        margin: 0 0 4px 0;
        font-size: 20px;
        font-weight: 600;
    }

    .table-header p {
        margin: 0;
        font-size: 13px;
        opacity: 0.9;
    }

    /* TABLE RESPONSIVE */
    .table-responsive {
        overflow-x: auto;
    }

    .reservations-table {
        width: 100%;
        border-collapse: collapse;
    }

    .reservations-table thead {
        background-color: #f8f9fa;
        border-bottom: 2px solid var(--border-color);
    }

    .reservations-table th {
        padding: 16px 20px;
        text-align: left;
        font-weight: 600;
        font-size: 13px;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .reservations-table th i {
        font-size: 14px;
        color: var(--primary-color);
    }

    .reservations-table tbody tr {
        border-bottom: 1px solid var(--border-color);
        transition: all 0.2s ease;
    }

    .reservations-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .reservations-table td {
        padding: 16px 20px;
        font-size: 14px;
        color: var(--text-primary);
    }

    .user-email {
        font-weight: 600;
        color: var(--text-primary);
    }

    .hotel-name {
        color: var(--text-secondary);
    }

    .date-badge {
        display: inline-block;
        padding: 6px 12px;
        background: #e7f3ff;
        color: #0066cc;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-cell {
        text-align: center;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: capitalize;
    }

    .status-confirmed {
        background: #d4edda;
        color: #155724;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    .status-default {
        background: #e2e3e5;
        color: #383d41;
    }

    .actions-col {
        text-align: center;
    }

    /* ACTIONS */
    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        padding: 0;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        text-decoration: none;
    }

    .btn-view {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .btn-view:hover {
        background-color: #0c5460;
        color: white;
    }

    .btn-edit {
        background-color: #cfe2ff;
        color: var(--primary-color);
    }

    .btn-edit:hover {
        background-color: var(--primary-color);
        color: white;
    }

    .btn-delete {
        background-color: #f8d7da;
        color: var(--danger-color);
        border: none;
    }

    .btn-delete:hover {
        background-color: var(--danger-color);
        color: white;
    }

    .delete-form {
        display: inline;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
    }

    .empty-state-icon {
        font-size: 80px;
        color: #ddd;
        margin-bottom: 20px;
    }

    .empty-state h2 {
        margin: 0 0 10px 0;
        font-size: 24px;
        color: var(--text-primary);
    }

    .empty-state p {
        margin: 0 0 30px 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

    /* RESPONSIVE */
    @media (max-width: 992px) {
        .header-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-create-new {
            width: 100%;
            justify-content: center;
        }

        .stats-section {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        }
    }

    @media (max-width: 768px) {
        .reservations-wrapper {
            padding: 20px 15px;
        }

        .reservations-header {
            padding: 20px;
        }

        .header-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-info i {
            font-size: 32px;
        }

        .header-info h1 {
            font-size: 22px;
        }

        .stats-section {
            grid-template-columns: 1fr;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .reservations-table th,
        .reservations-table td {
            padding: 12px 10px;
            font-size: 12px;
        }

        .user-email {
            min-width: 150px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            font-size: 14px;
        }
    }

    @media (max-width: 480px) {
        .reservations-wrapper {
            padding: 15px 10px;
        }

        .reservations-header {
            padding: 15px;
        }

        .header-info h1 {
            font-size: 18px;
        }

        .header-info i {
            font-size: 28px;
        }

        .btn-create-new {
            padding: 10px 16px;
            font-size: 12px;
        }

        .table-header {
            padding: 16px;
        }

        .reservations-table th,
        .reservations-table td {
            padding: 10px 8px;
            font-size: 11px;
        }

        .date-badge,
        .status-badge {
            font-size: 10px;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}
