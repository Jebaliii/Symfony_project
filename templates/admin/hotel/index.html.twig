{% extends 'base.html.twig' %}

{% block title %}Hotels Management{% endblock %}

{% block body %}
<div class="hotels-wrapper">
    <!-- HEADER SECTION -->
    <div class="hotels-header">
        <div class="header-top">
            <div class="header-info">
                <i class="bi bi-building"></i>
                <div>
                    <h1>Hotels Management</h1>
                    <p>Manage all your hotels in one place</p>
                </div>
            </div>
            <a href="{{ path('admin_hotel_new') }}" class="btn-create-new">
                <i class="bi bi-plus-lg"></i>
                <span>New Hotel</span>
            </a>
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="hotels-container">
        <!-- STATS CARDS -->
        {% set totalRooms = 0 %}
        {% set totalPrice = 0 %}
        {% for hotel in hotels %}
            {% set totalRooms = totalRooms + hotel.availableRooms %}
            {% set totalPrice = totalPrice + hotel.pricePerNight %}
        {% endfor %}
        
        <div class="stats-section">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Hotels</span>
                    <span class="stat-value">{{ hotels|length }}</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-door-open"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Rooms</span>
                    <span class="stat-value">{{ totalRooms }}</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-cash"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Avg Price</span>
                    <span class="stat-value">{{ (hotels|length > 0 ? (totalPrice / hotels|length)|round(0) : 0) }} TND</span>
                </div>
            </div>
        </div>

        <!-- HOTELS TABLE -->
        {% if hotels|length > 0 %}
        <div class="table-card">
            <div class="table-header">
                <h2>Hotels List</h2>
                <p>{{ hotels|length }} hotel{{ hotels|length > 1 ? 's' : '' }} available</p>
            </div>

            <div class="table-responsive">
                <table class="hotels-table">
                    <thead>
                        <tr>
                            <th>
                                <i class="bi bi-building"></i>
                                Name
                            </th>
                            <th>
                                <i class="bi bi-geo-alt"></i>
                                Location
                            </th>
                            <th>
                                <i class="bi bi-cash"></i>
                                Price
                            </th>
                            <th>
                                <i class="bi bi-door-open"></i>
                                Rooms
                            </th>
                            <th class="actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for hotel in hotels %}
                        <tr class="table-row">
                            <td class="hotel-name">
                                <strong>{{ hotel.name }}</strong>
                            </td>
                            <td class="hotel-city">
                                {{ hotel.city ?? hotel.address ?? 'N/A' }}
                            </td>
                            <td class="hotel-price">
                                <span class="price-badge">{{ hotel.pricePerNight }} TND</span>
                            </td>
                            <td class="hotel-rooms">
                                <span class="rooms-badge">{{ hotel.availableRooms }}</span>
                            </td>
                            <td class="actions-cell">
                                <div class="action-buttons">
                                    <a href="{{ path('admin_hotel_show', {id: hotel.id}) }}" class="btn-action btn-view" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_hotel_edit', {id: hotel.id}) }}" class="btn-action btn-edit" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin_hotel_delete', {id: hotel.id}) }}" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this hotel?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-hotel-' ~ hotel.id) }}">
                                        <button type="submit" class="btn-action btn-delete" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% else %}
        <!-- EMPTY STATE -->
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <h2>No Hotels Yet</h2>
            <p>Get started by creating your first hotel</p>
            <a href="{{ path('admin_hotel_new') }}" class="btn-create-new btn-lg">
                <i class="bi bi-plus-lg"></i>
                <span>Create First Hotel</span>
            </a>
        </div>
        {% endif %}
    </div>
</div>

<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --danger-color: #dc3545;
        --warning-color: #ffc107;
        --text-primary: #2c3e50;
        --text-secondary: #7f8c8d;
        --bg-light: #f5f7fb;
        --border-color: #e0e0e0;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
    }

    .hotels-wrapper {
        background-color: var(--bg-light);
        min-height: 100vh;
        padding: 30px 20px;
    }

    /* HEADER */
    .hotels-header {
        background: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: var(--shadow-sm);
    }

    .header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .header-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-info i {
        font-size: 40px;
        color: var(--primary-color);
    }

    .header-info h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .header-info p {
        margin: 0;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .btn-create-new {
        padding: 12px 24px;
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-create-new:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        color: white;
        text-decoration: none;
    }

    .btn-create-new.btn-lg {
        padding: 16px 32px;
        font-size: 16px;
    }

    /* CONTAINER */
    .hotels-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* STATS SECTION */
    .stats-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        border-radius: 12px;
        font-size: 24px;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 12px;
        color: var(--text-secondary);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
    }

    /* TABLE CARD */
    .table-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .table-header {
        padding: 24px;
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
    }

    .table-header h2 {
        margin: 0 0 4px 0;
        font-size: 20px;
        font-weight: 600;
    }

    .table-header p {
        margin: 0;
        font-size: 13px;
        opacity: 0.9;
    }

    /* TABLE RESPONSIVE */
    .table-responsive {
        overflow-x: auto;
    }

    .hotels-table {
        width: 100%;
        border-collapse: collapse;
    }

    .hotels-table thead {
        background-color: #f8f9fa;
        border-bottom: 2px solid var(--border-color);
    }

    .hotels-table th {
        padding: 16px 20px;
        text-align: left;
        font-weight: 600;
        font-size: 13px;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .hotels-table th i {
        font-size: 14px;
        color: var(--primary-color);
    }

    .hotels-table tbody tr {
        border-bottom: 1px solid var(--border-color);
        transition: all 0.2s ease;
    }

    .hotels-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .hotels-table td {
        padding: 16px 20px;
        font-size: 14px;
        color: var(--text-primary);
    }

    .hotel-name {
        font-weight: 600;
        color: var(--text-primary);
    }

    .hotel-city {
        color: var(--text-secondary);
    }

    .price-badge {
        display: inline-block;
        padding: 6px 12px;
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .rooms-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #f0f0f0;
        border-radius: 6px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .actions-col {
        text-align: center;
    }

    /* ACTIONS */
    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        padding: 0;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        text-decoration: none;
    }

    .btn-view {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .btn-view:hover {
        background-color: #0c5460;
        color: white;
    }

    .btn-edit {
        background-color: #cfe2ff;
        color: var(--primary-color);
    }

    .btn-edit:hover {
        background-color: var(--primary-color);
        color: white;
    }

    .btn-delete {
        background-color: #f8d7da;
        color: var(--danger-color);
        border: none;
    }

    .btn-delete:hover {
        background-color: var(--danger-color);
        color: white;
    }

    .delete-form {
        display: inline;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
    }

    .empty-state-icon {
        font-size: 80px;
        color: #ddd;
        margin-bottom: 20px;
    }

    .empty-state h2 {
        margin: 0 0 10px 0;
        font-size: 24px;
        color: var(--text-primary);
    }

    .empty-state p {
        margin: 0 0 30px 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

    /* RESPONSIVE */
    @media (max-width: 992px) {
        .header-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-create-new {
            width: 100%;
            justify-content: center;
        }

        .stats-section {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        }
    }

    @media (max-width: 768px) {
        .hotels-wrapper {
            padding: 20px 15px;
        }

        .hotels-header {
            padding: 20px;
        }

        .header-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-info i {
            font-size: 32px;
        }

        .header-info h1 {
            font-size: 22px;
        }

        .stats-section {
            grid-template-columns: 1fr;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .hotels-table th,
        .hotels-table td {
            padding: 12px 10px;
            font-size: 12px;
        }

        .hotel-name {
            min-width: 150px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            font-size: 14px;
        }
    }

    @media (max-width: 480px) {
        .hotels-wrapper {
            padding: 15px 10px;
        }

        .hotels-header {
            padding: 15px;
        }

        .header-info h1 {
            font-size: 18px;
        }

        .header-info i {
            font-size: 28px;
        }

        .btn-create-new {
            padding: 10px 16px;
            font-size: 12px;
        }

        .table-header {
            padding: 16px;
        }

        .hotels-table th,
        .hotels-table td {
            padding: 10px 8px;
            font-size: 11px;
        }

        .price-badge,
        .rooms-badge {
            font-size: 11px;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}
