{% extends 'base.html.twig' %}

{% block title %}Hotel: {{ hotel.name }}{% endblock %}

{% block body %}
<div class="hotel-detail-wrapper">
    <!-- HEADER SECTION WITH HOTEL INFO -->
    <div class="hotel-header">
        <div class="hotel-header-content">
            <div class="hotel-header-info">
                <i class="bi bi-building"></i>
                <div>
                    <h1>{{ hotel.name }}</h1>
                    <div class="hotel-meta">
                        <span class="hotel-location">
                            <i class="bi bi-geo-alt"></i> {{ hotel.address }}
                        </span>
                    </div>
                </div>
            </div>
            <span class="hotel-badge-active">
                <i class="bi bi-check-circle"></i> Active
            </span>
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="hotel-container">
        <div class="hotel-grid">
            <!-- LEFT COLUMN - MAIN INFO -->
            <div class="hotel-main">
                <!-- DESCRIPTION CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-file-text"></i> Description</h2>
                    </div>
                    <div class="card-body">
                        <p class="hotel-description">{{ hotel.description }}</p>
                    </div>
                </div>

                <!-- LOCATION CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-map"></i> Location</h2>
                    </div>
                    <div class="card-body">
                        <div class="info-item">
                            <span class="label">Address:</span>
                            <span class="value">{{ hotel.address }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN - SIDE INFO -->
            <div class="hotel-sidebar">
                <!-- PRICING CARD -->
                <div class="info-card sticky-card">
                    <div class="card-header">
                        <h2><i class="bi bi-cash"></i> Pricing</h2>
                    </div>
                    <div class="card-body">
                        <div class="price-box">
                            <span class="price-label">Price per Night</span>
                            <span class="price-value">{{ hotel.pricePerNight }}</span>
                            <span class="price-currency">TND</span>
                        </div>
                    </div>
                </div>

                <!-- ROOMS CARD -->
                <div class="info-card">
                    <div class="card-header">
                        <h2><i class="bi bi-door-open"></i> Rooms</h2>
                    </div>
                    <div class="card-body">
                        <div class="room-info">
                            <span class="room-label">Available Rooms:</span>
                            <span class="room-count">{{ hotel.availableRooms }}</span>
                        </div>
                    </div>
                </div>

                <!-- ACTIONS CARD -->
                <div class="actions-card">
                    <div class="card-body">
                        <a href="{{ path('admin_hotel_edit', {'id': hotel.id}) }}" class="btn-action btn-edit">
                            <i class="bi bi-pencil-square"></i>
                            <span>Edit</span>
                        </a>
                        <a href="{{ path('admin_hotel_index') }}" class="btn-action btn-back">
                            <i class="bi bi-arrow-left"></i>
                            <span>Back</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --danger-color: #dc3545;
        --warning-color: #ffc107;
        --text-primary: #2c3e50;
        --text-secondary: #7f8c8d;
        --bg-light: #f5f7fb;
        --border-color: #e0e0e0;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
    }

    .hotel-detail-wrapper {
        background-color: var(--bg-light);
        min-height: 100vh;
        padding: 30px 20px;
    }

    /* HEADER */
    .hotel-header {
        background: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: var(--shadow-sm);
    }

    .hotel-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .hotel-header-info {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        flex: 1;
    }

    .hotel-header-info i {
        font-size: 40px;
        color: var(--primary-color);
        margin-top: 5px;
    }

    .hotel-header-info h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .hotel-meta {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .hotel-location {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .hotel-location i {
        font-size: 16px;
        color: var(--primary-color);
    }

    .hotel-badge-active {
        background: #d4edda;
        color: #155724;
        padding: 10px 18px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    /* CONTAINER */
    .hotel-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .hotel-grid {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 30px;
    }

    .hotel-main {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .hotel-sidebar {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* CARDS */
    .info-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .info-card:hover {
        box-shadow: var(--shadow-md);
    }

    .sticky-card {
        position: sticky;
        top: 20px;
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card-header h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body {
        padding: 24px;
    }

    /* HOTEL DESCRIPTION */
    .hotel-description {
        margin: 0;
        line-height: 1.8;
        color: var(--text-primary);
        font-size: 15px;
    }

    /* INFO ITEMS */
    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-item .label {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 13px;
    }

    .info-item .value {
        color: var(--text-secondary);
        font-size: 14px;
    }

    /* PRICE BOX */
    .price-box {
        text-align: center;
        padding: 20px 0;
    }

    .price-label {
        display: block;
        font-size: 12px;
        color: var(--text-secondary);
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 10px;
        letter-spacing: 0.5px;
    }

    .price-value {
        display: block;
        font-size: 36px;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 5px;
    }

    .price-currency {
        font-size: 14px;
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ROOM INFO */
    .room-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .room-label {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 14px;
    }

    .room-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
        border-radius: 8px;
        font-size: 20px;
        font-weight: 700;
    }

    /* ACTIONS */
    .actions-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .actions-card .card-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 16px;
    }

    .btn-action {
        padding: 12px 16px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        border: 1.5px solid transparent;
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--primary-color), #0a58ca);
        color: white;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
    }

    .btn-back {
        background: white;
        color: var(--text-secondary);
        border: 1.5px solid var(--border-color);
    }

    .btn-back:hover {
        border-color: var(--text-secondary);
        background: var(--bg-light);
        color: var(--text-primary);
    }

    /* RESPONSIVE */
    @media (max-width: 992px) {
        .hotel-grid {
            grid-template-columns: 1fr;
        }

        .sticky-card {
            position: static;
        }

        .hotel-header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .hotel-badge-active {
            align-self: flex-start;
        }
    }

    @media (max-width: 768px) {
        .hotel-detail-wrapper {
            padding: 20px 15px;
        }

        .hotel-header {
            padding: 20px;
        }

        .hotel-header-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .hotel-header-info i {
            font-size: 32px;
        }

        .hotel-header-info h1 {
            font-size: 24px;
        }

        .card-body {
            padding: 16px;
        }

        .actions-card .card-body {
            flex-direction: column;
        }

        .btn-action {
            width: 100%;
        }
    }

    @media (max-width: 480px) {
        .hotel-detail-wrapper {
            padding: 15px 10px;
        }

        .hotel-header {
            padding: 15px;
        }

        .hotel-header-info h1 {
            font-size: 20px;
        }

        .hotel-header-info i {
            font-size: 28px;
        }

        .price-value {
            font-size: 28px;
        }

        .room-count {
            width: 45px;
            height: 45px;
            font-size: 18px;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}
